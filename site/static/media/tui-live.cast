[3.7339999999999995, "o", "\u001b[1;2H\u001b[38;5;141;49m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[2;2H\u2502\u001b[2;4H\u001b[1m\u273b \u001b[39;49mWelcome to \u001b[38;5;141;49mtm\u001b[39;49m!\u001b[2;84H\u001b[22m\u001b[38;5;141;49m\u2502\u001b[3;2H\u2502\u001b[3;84H\u2502\u001b[4;2H\u2502\u001b[4;6H\u001b[39;49m/help\u001b[38;5;8;49m for help, \u001b[39;49m/status\u001b[38;5;8;49m for your current setup\u001b[4;84H\u001b[38;5;141;49m\u2502\u001b[5;2H\u2502\u001b[5;84H\u2502\u001b[6;2H\u2502\u001b[6;4H\u001b[38;5;8;49m  cwd: \u001b[39;49m/var/folders/zp/63k3q7t13rb7bx4l8wnxshgh0000gn/T/opencode/tm-seed-Y3KGGy\u001b[6;84H\u001b[38;5;141;49m\u2502\u001b[7;2H\u2502\u001b[7;4H\u001b[38;5;8;49m  model: \u001b[39;49mdevpass/muse-spark-1.3-contributor\u001b[7;84H\u001b[38;5;141;49m\u2502\u001b[8;2H\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f"]
[3.7339999999999995, "o", "\u001b[10;3H\u001b[38;5;8;49mTips for getting started:\u001b[12;3H1. Ask tm to explain, fix, or build something in this project\u001b[13;3H2. Type ! to run a shell command, @ to mention a file\u001b[14;3H3. Press \u2190 twice for tickets: work tm does in the background\u001b[15;3H4. Be as specific as you would with another engineer for the best results\u001b[29;1H\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[30;1H\u2502\u001b[30;3H\u001b[1m\u001b[38;5;141;49m\u203a\u001b[30;5H\u001b[22m\u001b[38;5;234;48;5;254mA\u001b[38;5;8;49msk tm anything\u2026 (? for shortcuts, / for commands)\u001b[30;112H\u2502\u001b[31;1H\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
